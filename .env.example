# --- Core Settings ---
# Toggle Mock Mode (default: true). Set to false to use real Klaviyo API.
USE_MOCK_KLAVIYO=true

# Optional: Real Klaviyo Private API Key (pk_...)
# KLAVIYO_API_KEY=pk_...

# Server Port (default: 3000)
PORT=3000

# --- LLM Provider Settings ---
# Options: ollama, openai, http
LLM_PROVIDER=ollama

# 1. Ollama (Default) - Requires your own running instance
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct

# 2. OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# 3. Generic HTTP (e.g. LM Studio, VLLM)
# LLM_API_URL=http://localhost:1234/v1/chat/completions
